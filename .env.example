# ==============================================================================
# The Sender Moto — ตัวอย่างการตั้งค่า Environment Variables (.env.example)
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (ห้ามนำไฟล์ .env ขึ้น Git เด็ดขาด)
# ==============================================================================

# โหมดการทำงานของระบบ (development หรือ production)
# เมื่อตั้งเป็น production ระบบจะปิด /docs, /redoc, /openapi.json และบังคับใช้ Admin Auth เสมอ
APP_ENV=development

# 1. การเชื่อมต่อฐานข้อมูล MySQL / TiDB Cloud Starter (AWS Singapore: ap-southeast-1)
# - สำหรับรันในเครื่อง (Local MySQL): DB_HOST=127.0.0.1 และ DB_PORT=3306
# - สำหรับ TiDB Cloud Starter: DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com และ DB_PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=TheSenderMoto

# 2. การตั้งค่า TLS / SSL (จำเป็นสำหรับ TiDB Cloud Starter)
# หาก host มีคำว่า tidbcloud.com ระบบจะเปิด TLS ให้อัตโนมัติ หรือตั้ง DB_SSL_REQUIRED=true
DB_SSL_REQUIRED=false
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# 3. ความปลอดภัยสำหรับหน้าจัดการอู่ (Admin Dashboard)
# สร้างค่า ADMIN_PASSWORD_HASH และ ADMIN_SESSION_SECRET ด้วยคำสั่ง:
#   venv\Scripts\python create_admin.py
ADMIN_PASSWORD_HASH=admin123
ADMIN_SESSION_SECRET=admin123

# 4. การตั้งค่าคิวซ่อมและเวลาทำการของอู่ (ปรับเปลี่ยนได้โดยไม่ต้องแก้โค้ด)
MAX_CARS_PER_SLOT=2
MIN_LEAD_TIME_MINUTES=60
# วันหยุดพิเศษคั่นด้วยจุลภาค เช่น 2026-12-31,2027-01-01
WORKSHOP_HOLIDAYS=

# 5. การแจ้งเตือนผ่าน LINE Messaging API (โควตาฟรี 300 ข้อความ/เดือน)
# หากเว้นว่างไว้ ระบบจะบันทึกคิวซ่อมตามปกติโดยข้ามการส่ง LINE (NotificationStatus = Skipped)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=

# 6. รายการโดเมนที่อนุญาตให้เรียก API (CORS) คั่นด้วยเครื่องหมายจุลภาค (,) ห้ามใช้ *
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 7. ตัวแปรสำหรับฝั่ง Frontend (Next.js) — ห้ามใส่ข้อมูลความลับใน NEXT_PUBLIC_* เด็ดขาด
# - ตอนรันในเครื่อง: http://127.0.0.1:8000
# - ตอนรันบน Vercel (Single Project โดเมนเดียวกัน): /api
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=https://the-sender-moto.vercel.app
